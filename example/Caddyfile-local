{
	order s3proxy last
	debug
	auto_https disable_redirects
}

# change this to name from TLS certificate 
<caddy-host>:8443 {
	# using Local CA-issued certs
    tls <path-to-tls-certificate> <path-to-tls-certificate-private-key>
	log {
        output stdout
        format json
    }

    # Everything else from S3 snapshot bucket 
    handle {
        route {
            s3proxy {
                # Alternatively, configure a profile and mount its AWS credentials file.
                # profile <aws-profile>
                bucket <your-s3-bucket-name>
                # change region if you have a different one
                region us-east-1
                # your external firewall that NATs to VGW or StorageGRID LB with valid TLS cert
                endpoint https://<your-s3-api-endpoint>:<port>
                force_path_style
                # index index.html    # optional
                # browse              # disable directory listing for obscurity/security
            }
        }
    }
}
